# syntax=docker/dockerfile:1.7

# Dedicated Krea 2 Serverless image: DaSiWa Krea2 checkpoint + Civitai LoRAs.
#
# 5.10.0-base ships ComfyUI 0.34.0 (Krea 2 landed in 0.26.0) and comfy-cli 1.13.0
# (which knows civitai.red and attaches CIVITAI_API_TOKEN), so no ComfyUI or
# comfy-cli upgrade steps are needed any more.  Bump the tag deliberately.
FROM runpod/worker-comfyui:5.10.0-base

# Text encoder + VAE required by every Krea 2 checkpoint.
RUN comfy model download \
  --url https://huggingface.co/Comfy-Org/Krea-2/resolve/main/text_encoders/qwen3vl_4b_fp8_scaled.safetensors \
  --relative-path models/text_encoders \
  --filename qwen3vl_4b_fp8_scaled.safetensors

RUN comfy model download \
  --url https://huggingface.co/Comfy-Org/Krea-2/resolve/main/vae/qwen_image_vae.safetensors \
  --relative-path models/vae \
  --filename qwen_image_vae.safetensors

COPY runpod/download_baked_loras.py /tmp/download_baked_loras.py
COPY data/krea2_models.json /tmp/krea2_models.json
COPY data/krea2_baked_loras.json /tmp/krea2_baked_loras.json

# Civitai downloads (checkpoint, then LoRAs).  CIVITAI_API_TOKEN is a BuildKit
# secret only for these steps; it is not copied into the final image.  Keep NSFW
# assets on civitai.red.  Edit data/krea2_models.json / data/krea2_baked_loras.json.
RUN --mount=type=secret,id=civitai_api_token \
    CIVITAI_API_TOKEN="$(cat /run/secrets/civitai_api_token 2>/dev/null || true)" \
    && if [ -z "$CIVITAI_API_TOKEN" ]; then \
         echo "Missing BuildKit secret civitai_api_token (set GitHub secret CIVITAI_API_TOKEN)." >&2; \
         exit 1; \
       fi \
    && export CIVITAI_API_TOKEN \
    && python3 /tmp/download_baked_loras.py /tmp/krea2_models.json

RUN --mount=type=secret,id=civitai_api_token \
    CIVITAI_API_TOKEN="$(cat /run/secrets/civitai_api_token 2>/dev/null || true)" \
    && if [ -z "$CIVITAI_API_TOKEN" ]; then \
         echo "Missing BuildKit secret civitai_api_token (set GitHub secret CIVITAI_API_TOKEN)." >&2; \
         exit 1; \
       fi \
    && export CIVITAI_API_TOKEN \
    && python3 /tmp/download_baked_loras.py /tmp/krea2_baked_loras.json
