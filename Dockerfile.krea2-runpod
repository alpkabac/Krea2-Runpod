# syntax=docker/dockerfile:1.7

# Dedicated Krea 2 Serverless image.  Keep this separate from the Anima image:
# Krea needs different core weights and its LoRAs are acquired per job.
FROM runpod/worker-comfyui:5.8.5-base

# worker-comfyui ships an older comfy-cli that treats civitai.red as an unknown
# host and skips CIVITAI_API_TOKEN.  v1.7.3+ recognizes .red and attaches auth.
RUN pip install --no-cache-dir --upgrade "comfy-cli>=1.7.3"

# The 5.8.5-base image baked in whatever ComfyUI was "latest" on its March 2026
# build date (ComfyUI 0.17.2 / rev 4905). Krea 2 support (native `krea2`
# CLIPLoader type + the Krea2 single-stream DiT model class) only landed in
# ComfyUI upstream on 2026-06-22 (Comfy-Org/ComfyUI#14589), first shipping in
# tagged release v0.26.0 (2026-06-23). Without this, CLIPLoader type="krea2"
# fails prompt validation ("Value not in list"), and even swapping to a
# different CLIP type would silently mis-encode the prompt or fail model
# detection on UNETLoader, since 0.17.2 also predates model_detection.py /
# supported_models.py support for the Krea2 architecture entirely.
#
# Pin to a specific tag (not "latest") for reproducible builds.
#
# --skip-prompt is comfy-cli's actual non-interactive flag (it's a global
# option on the root `comfy` command, not `install` -- there is no `-y` on
# `install` itself; that belongs to the newer `comfy setup` wizard).
#
# --restore is required because /comfyui already exists in this base image:
# `install`'s CLI wrapper hard-stops with "ComfyUI is already installed...
# add '--restore'" otherwise (that check lives in cmdline.py, before
# install.py's execute() is ever called).
#
# --nvidia is required too: the CLI unconditionally errors out with "No GPU
# option selected" if none of --nvidia/--amd/--m-series/--intel-arc/--cpu is
# passed, regardless of --skip-torch-or-directml. But --skip-torch-or-directml
# makes that --nvidia choice a no-op for torch itself: it short-circuits BOTH
# the CUDA-tag resolution (`_resolve_cuda(...) if not skip_torch_or_directml
# else (cuda_version, None)`) and every torch-install branch inside
# pip_install_comfyui_dependencies. So this combination satisfies the CLI's
# validation without ever touching the base image's already-correct
# torch/CUDA build.
RUN comfy --skip-prompt --workspace /comfyui install --version v0.28.0 --nvidia --skip-torch-or-directml --restore

# comfy-cli installs ComfyUI into its own workspace venv (/comfyui/.venv), but
# worker-comfyui's start.sh launches ComfyUI with /opt/venv's python (see
# runpod-workers/worker-comfyui#227, "DR-1170"). Re-sync ComfyUI's + custom
# nodes' requirements into /opt/venv after the version bump, exactly like
# worker-comfyui's own 5.8.6 fix does, so the launch venv doesn't end up
# missing a dependency the new ComfyUI version needs.
RUN pip install --no-cache-dir -r /comfyui/requirements.txt \
    && for r in /comfyui/custom_nodes/*/requirements.txt; do \
         [ -f "$r" ] && pip install --no-cache-dir -r "$r" || true; \
       done

# Build-time smoke test: actually import/start ComfyUI on CPU so a bad version
# bump fails the GitHub Actions build with a clear traceback, instead of
# silently shipping an image that fails at runtime on a live RunPod worker.
RUN cd /comfyui && timeout 300 python main.py --quick-test-for-ci --cpu

COPY comfyui_custom_nodes/ComfyUI-Megumin-NanoGPT /comfyui/custom_nodes/ComfyUI-Megumin-NanoGPT
COPY comfyui_custom_nodes/ComfyUI-Megumin-RuntimeLora /comfyui/custom_nodes/ComfyUI-Megumin-RuntimeLora
COPY data/krea2_baked_loras.json /tmp/krea2_baked_loras.json
COPY runpod/download_baked_loras.py /tmp/download_baked_loras.py

# Core Krea 2 Turbo files.  The fp8 text encoder keeps the Serverless footprint
# practical; all three paths match the supplied Krea API workflow.
RUN comfy model download \
  --url https://huggingface.co/Comfy-Org/Krea-2/resolve/main/diffusion_models/krea2_turbo_fp8_scaled.safetensors \
  --relative-path models/diffusion_models \
  --filename krea2_turbo_fp8_scaled.safetensors

RUN comfy model download \
  --url https://huggingface.co/Comfy-Org/Krea-2/resolve/main/text_encoders/qwen3vl_4b_fp8_scaled.safetensors \
  --relative-path models/text_encoders \
  --filename qwen3vl_4b_fp8_scaled.safetensors

RUN comfy model download \
  --url https://huggingface.co/Comfy-Org/Krea-2/resolve/main/vae/qwen_image_vae.safetensors \
  --relative-path models/vae \
  --filename qwen_image_vae.safetensors

# Add Civitai or Hugging Face LoRAs to data/krea2_baked_loras.json.  Keep NSFW
# assets on civitai.red.  CIVITAI_API_TOKEN is a BuildKit secret only for this
# step; it is not copied into the final image.
RUN --mount=type=secret,id=civitai_api_token \
    CIVITAI_API_TOKEN="$(cat /run/secrets/civitai_api_token 2>/dev/null || true)" \
    && if [ -z "$CIVITAI_API_TOKEN" ]; then \
         echo "Missing BuildKit secret civitai_api_token (set GitHub secret CIVITAI_API_TOKEN)." >&2; \
         exit 1; \
       fi \
    && export CIVITAI_API_TOKEN \
    && python3 /tmp/download_baked_loras.py /tmp/krea2_baked_loras.json

# Change only when deliberately widening the allowed runtime source.  The custom
# node defaults to this same value, but making it visible aids endpoint debugging.
ENV MEGUMIN_RUNTIME_LORA_REPOS=malcolmrey/krea2
